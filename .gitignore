!/src/
!/src/**
!/tests/
!/tests/**
!/eng/
!/eng/**
!/docs/
!/docs/**
!/bench/
!/bench/fixtures.tsv
!/bench/results/
!/bench/results/**
!/bench/RoslynBridge.Benchmarks/
!/bench/RoslynBridge.Benchmarks/**

# Generated files and local settings stay ignored inside allowed dirs
**/bin/
**/obj/
**/node_modules/
/docs/.astro/
/docs/dist/
**/TestResults/
**/BenchmarkDotNet.Artifacts/
**/.DS_Store
**/*.user
**/*.suo
**/.env
**/.env.*
