# Ignore everything by default
*

# Except this
!/.gitignore
!/.editorconfig
!/.gitattributes
!/.oxfmtrc.json
!/.rumdl.toml
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/mise.toml
!/mise.lock
!/hk.pkl
!/Directory.Build.props
!/Directory.Packages.props
!/RoslynBridge.slnx
!/global.json
!/nuget.config
!/.roslyn-bridge.json
!/roslyn-bridge.code-workspace
!/.lazy.lua

!/.devcontainer/
!/.devcontainer/devcontainer.json
!/.devcontainer/Dockerfile
!/.github/
!/.github/renovate.json
!/.github/workflows/
!/.github/workflows/docs.yml
!/.github/workflows/ci.yml
!/.pi/
!/.pi/extensions/
!/.pi/extensions/format.ts
!/.pi/skills/
!/.pi/skills/roslyn/
