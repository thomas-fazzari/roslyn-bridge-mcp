# Ignore everything by default
*

# Except this
!/.gitignore
!/.editorconfig
!/.markdownlint-cli2.yaml
!/.gitattributes
!/.oxfmtrc.json
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/mise.toml
!/Directory.Build.props
!/Directory.Packages.props
!/RoslynBridge.slnx
!/global.json
!/package.json
!/install.sh
!/install.ps1
!/bun.lock
!/bunfig.toml
!/nuget.config
!/lefthook.yml
!/.roslyn-bridge.json
!/roslyn-bridge.code-workspace

!/.devcontainer/
!/.devcontainer/devcontainer.json
!/.devcontainer/Dockerfile
!/.github/
!/.github/dependabot.yml
!/.github/workflows/
!/.github/workflows/docs.yml
!/.github/workflows/ci.yml
!/.pi/
!/.pi/extensions/
!/.pi/extensions/format.ts

!/src/
!/src/**
!/tests/
!/tests/**
!/eng/
!/eng/**
!/docs/
!/docs/**

# Generated files and local settings stay ignored inside allowed dirs
**/bin/
**/obj/
**/node_modules/
/docs/.astro/
/docs/dist/
**/TestResults/
**/.DS_Store
**/*.user
**/*.suo
**/.env
**/.env.*
