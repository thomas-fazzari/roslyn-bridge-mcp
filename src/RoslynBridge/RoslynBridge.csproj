<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <Description>Lightweight MCP for C# diagnostics, navigation and refactoring, backed by the official Roslyn language server.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Tool package">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>ThomasFazzari.RoslynBridge</PackageId>
    <ToolCommandName>roslyn-bridge-mcp</ToolCommandName>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://thomas-fazzari.github.io/roslyn-bridge-mcp/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thomas-fazzari/roslyn-bridge-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;model-context-protocol;roslyn;csharp;language-server;coding-agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild derives a shorter name when the project path goes through a symlink -->
    <EmbeddedResource
      Include="Lsp/ClientCapabilities.json"
      LogicalName="RoslynBridge.Lsp.ClientCapabilities.json"
    />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../NOTICE" Pack="true" PackagePath="" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RoslynServerVersion" Value="$(RoslynServerVersion)" />
    <!-- Roslyn loads the extension into its own process. The bridge ships it without referencing it -->
    <ProjectReference
      Include="../RoslynBridge.Extension/RoslynBridge.Extension.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      OutputItemType="RoslynExtension"
    />
  </ItemGroup>

  <Target Name="IncludeRoslynExtension" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <ContentWithTargetPath
        Include="@(RoslynExtension)"
        TargetPath="extension/%(Filename)%(Extension)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="RoslynBridge.Tests" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Fastenshtein" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
</Project>
