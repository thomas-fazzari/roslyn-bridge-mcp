{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": null,
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dependencies"
    },
    {
      "description": "Releases several times a week",
      "matchPackageNames": ["Meziantou.Analyzer"],
      "enabled": false
    },
    {
      "description": "The oxc repository prefixes the tags of each tool",
      "matchDepNames": ["aqua:oxc-project/oxc/oxfmt"],
      "extractVersion": "^oxfmt_v(?<version>.+)$"
    },
    {
      "description": "The mise manager skips dotnet, so the SDK and its mise.lock entry are updated manually until renovatebot/renovate#44650",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk"],
      "enabled": false
    },
    {
      "description": "Relocatable Perl versions have four parts, such as 5.44.0.0",
      "matchDepNames": ["aqua:skaji/relocatable-perl"],
      "versioning": "loose"
    }
  ]
}
