<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RoslynServerVersion>5.13.0-1.26514.10</RoslynServerVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="Fastenshtein" Version="1.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="11.0.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.338" />
  </ItemGroup>
</Project>
