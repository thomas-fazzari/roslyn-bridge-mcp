#!/bin/sh
# PostToolUse hook: formats the file Claude just edited with the repository formatters.
# Hooks do not always inherit the interactive shell PATH, so add the usual tool locations.
PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
export PATH

file=$(jq -r '.tool_input.file_path // empty')
if [ -z "$file" ] || [ ! -f "$file" ]; then
  exit 0
fi

cd "$CLAUDE_PROJECT_DIR" || exit 0
case "$file" in
  *.cs | *.csx | *.csproj | *.props | *.targets | *.slnx)
    csharpier format "$file" >/dev/null ;;
  *.md | *.json | *.jsonc | *.yml | *.yaml | *.toml | *.js | *.mjs | *.ts)
    bunx --bun oxfmt --write --no-error-on-unmatched-pattern "$file" >/dev/null ;;
esac
exit 0
