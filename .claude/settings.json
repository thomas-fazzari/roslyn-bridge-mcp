{
  "permissions": {
    "allow": ["Bash(mise run *)", "Bash(dotnet test *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.pl" }
        ]
      }
    ]
  }
}
